{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nospe",
  "version": "0.1.0",
  "identifier": "de.janoschbl.nospe",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Nospe",
        "width": 459,
        "height": 760,
        "resizable": false,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/nospe-backend"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
